<resources>
    <layouts>
        <layout id="ReminderListLayout">
            <label x="center" y="10" text="@Strings.ReminderListTitle" font="Gfx.FONT_MEDIUM" justification="Gfx.TEXT_JUSTIFY_CENTER"/>
            <label x="center" y="center" text="@Strings.NoReminders" font="Gfx.FONT_SMALL" justification="Gfx.TEXT_JUSTIFY_CENTER"/>
        </layout>
        <layout id="ReminderAlertLayout">
            <label x="center" y="30" text="@Strings.ReminderFired" font="Gfx.FONT_LARGE" justification="Gfx.TEXT_JUSTIFY_CENTER"/>
            <label id="ReminderText" x="center" y="center" text="Reminder Text Here" font="Gfx.FONT_MEDIUM" justification="Gfx.TEXT_JUSTIFY_CENTER"/>
            <label x="center" y="175" text="@Strings.Dismiss" font="Gfx.FONT_SMALL" justification="Gfx.TEXT_JUSTIFY_CENTER"/>
        </layout>
        <layout id="ReminderEditLayout">
            <label x="center" y="10" text="@Strings.EditReminder" font="Gfx.FONT_MEDIUM" justification="Gfx.TEXT_JUSTIFY_CENTER"/>
            <label x="center" y="center" text="Edit fields below" font="Gfx.FONT_SMALL" justification="Gfx.TEXT_JUSTIFY_CENTER"/>
        </layout>
    </layouts>
</resources>
